# Copy this file as .env in the stack folder (on the NAS) and fill it in. Never upload the .env to GitHub.
# Families, accounts and their data live in the database (HOST_DATA_DIR), not here.

# ---- container (docker/compose.yml) ----
IMAGE_REPOSITORY=jaimetur/mam-ia
IMAGE_TAG=latest
CONTAINER_NAME=mamia
# the NAS reverse proxy already publishes mamia.jtgcloud.com on this port
APP_PORT=5071
HOST_DATA_DIR=/volume1/docker/data/mamia
# user and group the server runs as: they need write access to HOST_DATA_DIR
# (on the Synology NAS, the ACLs of /volume1/docker give it to docker_users: docker_limited = 1034, docker_users = 65544)
PUID=1034
PGID=65544

# ---- application ----
TZ=Europe/Madrid
# public address (links in emails and Stripe's return pages), without the final slash
PUBLIC_URL=https://mamia.jtgcloud.com
# the server administrator, made once with an empty database (the password must be changed on entering);
# their own family is free for life
MAMIA_ADMIN_EMAIL=
MAMIA_ADMIN_NAME=Jaime
MAMIA_ADMIN_PASSWORD=mamia-cambiar
MAMIA_ADMIN_FAMILY=Mi familia
# contact address (legal pages and the push notifications' VAPID contact)
MAMIA_CONTACT_EMAIL=mamia@jtgcloud.com
# 1 = families can sign up without paying (only for a private server; on the public one, leave it empty)
OPEN_SIGNUP=
# optional: key that encrypts the secrets in the database (else one is made in HOST_DATA_DIR/secrets/app.key)
SECRET_KEY=
# days a session and a family invitation last
SESSION_DAYS=180
INVITE_DAYS=14

# ---- outgoing email ----
# Required to sign up (every new account confirms its address with an emailed code); it also sends invitations,
# password resets, reminders, the summary of the day and the notices of the account and the subscription.
# What is saved in Administración → Correo wins over these. SMTP_HOST=log writes the emails to the log instead
# (local development only).
SMTP_HOST=mail.jtgcloud.com
SMTP_PORT=465
# ssl (port 465), starttls (587) or none
SMTP_SECURITY=ssl
SMTP_USERNAME=mamia@jtgcloud.com
SMTP_PASSWORD=
SMTP_FROM=mamia@jtgcloud.com
SMTP_FROM_NAME=Mam-IA

# Stripe (payments) is set in Administración → Pagos con Stripe, not here.
